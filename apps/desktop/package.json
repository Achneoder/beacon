{
  "name": "desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Beacon desktop client — automatic time tracking from the app lifecycle",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm --filter @beacon/shared build && tsc -p tsconfig.build.json",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @beacon/shared build && vitest run",
    "test:watch": "vitest",
    "dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "@beacon/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  }
}
