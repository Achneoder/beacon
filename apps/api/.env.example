PORT=3000
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://beacon:beacon@localhost:5432/beacon

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Refresh token cookie. Dev serves web and api on different ports of localhost — same
# site, so Lax is sent. Split them across domains and this needs none + secure.
AUTH_COOKIE_NAME=beacon_refresh
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false

# Object storage — MinIO by default, any S3-compatible endpoint works
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=beacon
STORAGE_SECRET_KEY=beacon-secret
STORAGE_BUCKET=beacon-documents
