PORT=3000
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://beacon:beacon@localhost:5432/beacon

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Refresh token cookie. Dev serves web and api on different ports of localhost — same
# site, so Lax is sent. Split them across domains and this needs none + secure.
AUTH_COOKIE_NAME=beacon_refresh
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false

# Object storage — MinIO by default, any S3-compatible endpoint works
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=beacon
STORAGE_SECRET_KEY=beacon-secret
STORAGE_BUCKET=beacon-documents
# none | sse-s3. sse-s3 needs a MinIO with a KMS configured (MINIO_KMS_SECRET_KEY) —
# the bundled dev compose does not set one, so the API refuses to start rather than
# claim encryption that is not actually on.
STORAGE_ENCRYPTION=none

# Outbound email — Mailpit in infra/docker-compose.yml catches everything on 1025 and
# shows it at http://localhost:8025. Leave MAIL_HOST empty and mail is logged, not sent.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Beacon <beacon@localhost>

# Where an emailed link points. Falls back to CORS_ORIGIN.
WEB_BASE_URL=http://localhost:5173
