PORT=3000
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://beacon:beacon@localhost:5432/beacon

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# How long after a rotation a spent refresh token is read as "a second tab of the same
# browser" rather than a stolen-token replay, in milliseconds. Outside this window,
# replaying a spent token revokes the whole token family. 0 disables the grace.
REFRESH_REPLAY_GRACE_MS=30000

# Refresh token cookie. Dev serves web and api on different ports of localhost — same
# site, so Lax is sent. Split them across domains and this needs none + secure.
AUTH_COOKIE_NAME=beacon_refresh
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false

# Object storage — MinIO by default, any S3-compatible endpoint works
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=beacon
STORAGE_SECRET_KEY=beacon-secret
STORAGE_BUCKET=beacon-documents
# none | sse-s3. sse-s3 needs a MinIO with a KMS configured (MINIO_KMS_SECRET_KEY) —
# the bundled dev compose does not set one, so the API refuses to start rather than
# claim encryption that is not actually on.
STORAGE_ENCRYPTION=none

# Search — Meilisearch in infra/docker-compose.yml. Leave SEARCH_HOST empty and Beacon
# runs with no search at all: indexing becomes a no-op, /search returns nothing, and the
# web app hides its search field rather than offering a box that can only come back
# empty. The index holds no permission data, so it can be rebuilt at any time from
# /settings/organization — see POST /api/search/reindex.
SEARCH_HOST=localhost
SEARCH_PORT=7700
SEARCH_USE_SSL=false
SEARCH_API_KEY=beacon-search-key
SEARCH_INDEX=beacon

# Outbound email — Mailpit in infra/docker-compose.yml catches everything on 1025 and
# shows it at http://localhost:8025. Leave MAIL_HOST empty and mail is logged, not sent.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Beacon <beacon@localhost>

# Where an emailed link points. Falls back to CORS_ORIGIN.
WEB_BASE_URL=http://localhost:5173

# SSO (OIDC). Leave SSO_ENCRYPTION_KEY empty and SSO cannot be configured at all — the
# settings screen refuses to save a provider, and the login screen offers a password
# only. 32 bytes, base64: openssl rand -base64 32
SSO_ENCRYPTION_KEY=
# The origin the IdP redirects back to. The settings screen shows
# <API_PUBLIC_URL>/api/auth/sso/callback for pasting into the IdP's own configuration.
API_PUBLIC_URL=http://localhost:3000
