{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @beacon/shared build && vite dev",
		"build": "pnpm --filter @beacon/shared build && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "pnpm --filter @beacon/shared build && vitest run",
		"test:e2e": "node tests/services.mjs && playwright test",
		"test:e2e:ui": "node tests/services.mjs && playwright test --ui",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@beacon/shared": "workspace:*",
		"layercake": "^10.0.3",
		"svelte-i18n": "^4.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.6",
		"eslint": "^9.18.0",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.14.0",
		"jsdom": "^26.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.20.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.2"
	}
}
